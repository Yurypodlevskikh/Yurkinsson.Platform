{
  "Frontend": {
    "BaseUrl": "https://speedup.yurkinsson.com"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "YurkinssonAuthentication": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MariaDB",
        "Args": {
          "connectionString": "Default_Connection",
          "tableName": "YurkinIdentityLogs",
          "autoCreateTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "YurkinssonAuthentication" }
  },
  "JwtYurkIdentity": {
    "Key": "key",
    "Issuer": "issuer",
    "Audiences": "speedup-backend.yurkinsson.com,localhost:7110",
    "TokenExpirationInMinutes": 10,
    "RefreshTokenExpiry": 12
  },
  "RegisteredApplications": "https://localhost:7261,https://speedupapi.yurkinsson.com",
  "ClientRedirectUrls": {
    "RememberText": "https://remembertext.yurkinsson.com",
    "SpeedUpVue": "https://speedup.yurkinsson.com",
    "SpeedUpMiniApi": "https://speedup-backend.yurkinsson.com"
  },
  "SmtpNoreplYurkiHost": {
    "Smtp": "",
    "Port": 0,
    "From": "",
    "Pass": ""
  },
  "AllowedHosts": "*"
}
